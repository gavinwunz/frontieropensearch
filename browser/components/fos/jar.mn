browser.jar:
    content/browser/fos/fos-tokens.css (content/fos-tokens.css)
    content/browser/fos/fos-commandbar.css (content/fos-commandbar.css)
    content/browser/fos/fos-field.css (content/fos-field.css)
    content/browser/fos/fos-links.css (content/fos-links.css)
    content/browser/fos/fos-locationdisplay.css (content/fos-locationdisplay.css)
    content/browser/fos/fos-contextsidebar.css (content/fos-contextsidebar.css)
    content/browser/fos/fos-trailrail.css (content/fos-trailrail.css)
    content/browser/fos/fos-voice.css (content/fos-voice.css)

    # The Context Engine's migrations are packaged so the store can read them at
    # runtime. They stay .sql files rather than strings in a module because
    # SCHEMA.md makes a shipped migration immutable, and a numbered file that is
    # only ever added to is what makes that auditable.
    content/browser/fos/migrations/001-initial.sql (/context-engine/migrations/001-initial.sql)
    content/browser/fos/migrations/002-merged-contexts.sql (/context-engine/migrations/002-merged-contexts.sql)
