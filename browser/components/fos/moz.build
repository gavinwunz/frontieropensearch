XPCSHELL_TESTS_MANIFESTS += ["tests/unit/xpcshell.toml"]
BROWSER_CHROME_MANIFESTS += ["tests/browser/browser.toml"]

JAR_MANIFESTS += ["jar.mn"]

EXTRA_JS_MODULES += [
    "FOSActions.sys.mjs",
    "FOSChrome.sys.mjs",
    "FOSCommandBar.sys.mjs",
    "FOSCommandBarView.sys.mjs",
    "FOSCommandParser.sys.mjs",
    "FOSContextEngine.sys.mjs",
    "FOSContextMerge.sys.mjs",
    "FOSContextPack.sys.mjs",
    "FOSContextSidebar.sys.mjs",
    "FOSContextSidebarView.sys.mjs",
    "FOSContextSignals.sys.mjs",
    "FOSContextStore.sys.mjs",
    "FOSEmbeddings.sys.mjs",
    "FOSField.sys.mjs",
    "FOSFieldSurface.sys.mjs",
    "FOSFieldView.sys.mjs",
    "FOSForget.sys.mjs",
    "FOSForgetPreview.sys.mjs",
    "FOSGrammar.sys.mjs",
    "FOSLinkMarks.sys.mjs",
    "FOSLinkSurface.sys.mjs",
    "FOSLocationDisplay.sys.mjs",
    "FOSMarks.sys.mjs",
    "FOSPlacesFloor.sys.mjs",
    "FOSSuggest.sys.mjs",
    "FOSTrailRail.sys.mjs",
    "FOSTrailRailView.sys.mjs",
    "FOSTrailSession.sys.mjs",
    "FOSTrailTree.sys.mjs",
    "FOSVoiceInput.sys.mjs",
    "FOSVoiceSession.sys.mjs",
    "FOSVoiceTranscript.sys.mjs",
]

# The page's half of link marks. Actors are packaged separately from the
# window's modules because they are loaded into a content process: everything
# above this line runs in the parent and may import Gecko's chrome-only modules,
# and nothing here may.
FINAL_TARGET_FILES.actors += [
    "actors/FOSLinksChild.sys.mjs",
    "actors/FOSLinksParent.sys.mjs",
]
